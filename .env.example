# Copy to `.env`. Never commit the real `.env`.

# --- Database (Postgres) ---
# Local SQLite is no longer used (Vercel cannot run SQLite).
# Easiest: Vercel → Storage → Create Neon DB, then paste DATABASE_URL here too.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# --- Admin panel (/admin) ---
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="eztravel123"
ADMIN_SESSION_SECRET="replace-with-a-long-random-string-at-least-24-chars"

# --- Partner portal session ---
PARTNER_SESSION_SECRET="replace-with-a-long-random-string-at-least-24-chars"

# --- Payment destinations ---
NEXT_PUBLIC_ZELLE_RECIPIENT_NAME="ezTravel LLC"
NEXT_PUBLIC_ZELLE_RECIPIENT_HANDLE="pay@your-domain.example"
NEXT_PUBLIC_VENMO_HANDLE="@ezTravel"
NEXT_PUBLIC_WECHAT_ID="ezTravelPay"
NEXT_PUBLIC_CASH_INSTRUCTIONS="Arrange cash with partner support, then submit the INV request."

# --- eSIM Access (mock when empty / USE_MOCK=1) ---
ESIMACCESS_ACCESS_CODE=""
ESIMACCESS_SECRET_KEY=""
ESIMACCESS_USE_MOCK=1

# --- Email (optional) ---
EMAIL_FROM="ezTravel <noreply@your-domain.example>"
RESEND_API_KEY=""

# --- Public site origin ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Support contacts ---
NEXT_PUBLIC_SUPPORT_PHONE="+1-555-0100"
NEXT_PUBLIC_SUPPORT_EMAIL="partners@eztravel.example"
NEXT_PUBLIC_SUPPORT_SMS="+1-555-0100"
