# Copy this file to `.env` and fill in real values before running the app.
# Never commit your real `.env` file.

# --- Database ---
DATABASE_URL="file:./dev.db"

# --- Admin panel (/admin) — required in production ---
# Use a strong unique password (12+ characters) and a long random session secret.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_SESSION_SECRET="replace-with-a-long-random-string-at-least-24-chars"

# --- Partner portal session ---
# Falls back to ADMIN_SESSION_SECRET when unset.
PARTNER_SESSION_SECRET="replace-with-a-long-random-string-at-least-24-chars"

# --- Payment destinations (consumer Zelle + partner top-up instructions) ---
NEXT_PUBLIC_ZELLE_RECIPIENT_NAME="ezTravel LLC"
NEXT_PUBLIC_ZELLE_RECIPIENT_HANDLE="pay@your-domain.example"
NEXT_PUBLIC_VENMO_HANDLE="@ezTravel"
NEXT_PUBLIC_WECHAT_ID="ezTravelPay"
NEXT_PUBLIC_CASH_INSTRUCTIONS="Arrange cash with partner support, then submit the INV request."

# --- eSIM Access Open API (https://docs.esimaccess.com/) ---
# Leave empty or set ESIMACCESS_USE_MOCK=1 to use the local mock provider.
# Set ESIMACCESS_USE_MOCK=0 with real credentials to go live.
ESIMACCESS_ACCESS_CODE=""
ESIMACCESS_SECRET_KEY=""
# ESIMACCESS_BASE_URL="https://api.esimaccess.com/api/v1/open"
# ESIMACCESS_USE_MOCK=1

# --- Email (Resend) — optional; logs to console when RESEND_API_KEY is unset ---
EMAIL_FROM="ezTravel <noreply@your-domain.example>"
RESEND_API_KEY=""

# --- Public site origin (delivery / QuickShare links) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Master support contacts shown in partner Help/Support ---
NEXT_PUBLIC_SUPPORT_PHONE="+1-555-0100"
NEXT_PUBLIC_SUPPORT_EMAIL="partners@eztravel.example"
NEXT_PUBLIC_SUPPORT_SMS="+1-555-0100"
