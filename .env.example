# Copy this file to `.env` and fill in real values before running the app.
# Never commit your real `.env` file.

DATABASE_URL="file:./prisma/dev.db"

# Admin panel (/admin) — required in production
# Use a strong unique password (12+ characters) and a long random session secret.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_SESSION_SECRET="replace-with-a-long-random-string-at-least-24-chars"

# Shown to customers on Zelle payment instructions
NEXT_PUBLIC_ZELLE_RECIPIENT_NAME="ezTravel LLC"
NEXT_PUBLIC_ZELLE_RECIPIENT_HANDLE="pay@your-domain.example"
